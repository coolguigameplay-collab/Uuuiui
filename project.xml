<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- _________________________ Application Settings _________________________ -->

	<!-- Build with specific libraries -->
	<architecture exclude="armv7" if="ONLY_ARM64" />
	<architecture exclude="armeabi-v7a" if="ONLY_ARM64" />
	<architecture exclude="arm64" if="ONLY_ARMV7" />
	<architecture exclude="arm64-v8a" if="ONLY_ARMV7" />

	<app
		title="Codename Engine"
		main="funkin.backend.system.Main"
		file="CodenameEngine"
		packageName="com.yoshman29.codenameengine"
		package="com.yoshman29.codenameengine"
		version="1.0.1"
		company="Yoshman29" />

	<!-- _________________________ Save Settings _________________________ -->

	<haxedef name="SAVE_PATH" value="CodenameEngine"/>
	<haxedef name="SAVE_NAME" value="save-default"/>

	<haxedef name="SAVE_OPTIONS_PATH" value="CodenameEngine"/>
	<haxedef name="SAVE_OPTIONS_NAME" value="options"/>

	<!-- Switch Export with Unique ApplicationID and Icon -->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!--
		DO NOT REMOVE!!
		ALLOWS REGIONS LIKE IN C# AND KEEPS CODE ORGANIZED.
	-->
	<haxedef name="REGION" />

	<!-- Flixel preloader -->
	<app preloader="flixel.system.FlxPreloader" />

	<!-- Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2 -->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!-- These window settings apply to all targets -->
	<window
		width="1280"
		height="720"
		background="#000000"
		hardware="true"
		vsync="false" />

	<!-- HTML5-specific -->
	<window
		if="html5"
		resizable="true" />

	<!-- Desktop-specific -->
	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
		vsync="false"/>

	<window
		if="mac"
		allow-high-dpi="true" />

	<!-- Mobile-specific -->
	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="false"/>

	<!-- Switch-specific -->
	<window
		if="switch"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="true" />

	<!-- _________________________________ Engine Settings _______________________________ -->

	<!-- Multi-port support -->
	<define name="ARKOSE_PORT"/>

	<!-- Standalone assets mode
		 The embedded assets/ folder is the main game content.
		 External mods/ loading is disabled. -->
	<haxedef name="STANDALONE_ASSETS" />

	<!-- Update checking -->
	<define
		name="UPDATE_CHECKING"
		unless="web || hl || neko || debug || mobile"/>

	<!-- Discord RPC -->
	<section if="cpp">
		<define
			name="DISCORD_RPC"
			if="desktop"/>
	</section>

	<!--
		Uncomment to achieve faster compile times.
	-->
	<!-- <define name="STRIPPED_COMPILE" unless="debug"/> -->

	<!-- Modcharting -->
	<define
		name="MODCHARTING_FEATURES"
		unless="STRIPPED_COMPILE" />

	<!-- GitHub API -->
	<define
		name="GITHUB_API"
		unless="web || hl"/>

	<!-- Compile all classes -->
	<define
		name="COMPILE_ALL_CLASSES"
		unless="STRIPPED_COMPILE" />

	<!-- Custom classes -->
	<define
		name="CUSTOM_CLASSES"
		unless="STRIPPED_COMPILE" />

	<!-- HScript abstract support -->
	<haxedef
		name="HSCRIPT_ABSTRACT_SUPPORT"
		unless="STRIPPED_COMPILE" />

	<!-- Multithreading -->
	<haxedef
		name="ALLOW_MULTITHREADING"
		unless="web || flash" />

	<!--
		External mods system.

		Disabled automatically in STANDALONE_ASSETS mode.
	-->
	<haxedef
		name="MOD_SUPPORT"
		unless="web || STANDALONE_ASSETS" />

	<!-- Translations -->
	<haxedef name="TRANSLATIONS_SUPPORT"/>

	<!-- Global scripts -->
	<haxedef name="GLOBAL_SCRIPT" />

	<!-- Softcoded states -->
	<haxedef name="SOFTCODED_STATES" />

	<!-- Custom NDLL support -->
	<haxedef
		name="NDLLS_SUPPORTED"
		unless="web || iphonesim || hl" />

	<!--
		USE_ADAPTED_ASSETS is intentionally disabled.

		The standalone build uses the normal embedded OpenFL
		assets/ library instead of an external adapted assets folder.
	-->

	<!-- Away3D -->
	<define
		name="THREE_D_SUPPORT"
		unless="STRIPPED_COMPILE" />

	<!-- Nape -->
	<define
		name="NAPE_ENABLED"
		unless="STRIPPED_COMPILE" />

	<!-- Video cutscenes -->
	<section if="cpp">
		<define
			name="VIDEO_CUTSCENES"
			if="desktop || mobile" />
	</section>

	<!-- FPS build information -->
	<define name="SHOW_BUILD_ON_FPS" />

	<!-- Dark mode windows -->
	<define name="DARK_MODE_WINDOW"/>

	<!-- Reflection optimization -->
	<define name="FLX_NO_GENERIC" />

	<!-- ______________________________ Libraries ______________________________ -->

	<!-- Version checks -->
	<define name="disable-version-check"/>
	<haxedef name="disable-version-check"/>

	<haxedef name="no-deprecation-warnings"/>

	<haxedef
		name="DISCORD_DISABLE_IO_THREAD"
		if="DISCORD_RPC"/>

	<!-- HaxeFlixel -->
	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />

	<!-- Video -->
	<haxelib
		name="hxvlc"
		if="VIDEO_CUTSCENES" />

	<!-- 3D -->
	<haxelib
		name="away3d"
		if="THREE_D_SUPPORT" />

	<!-- Libraries -->
	<haxelib name="format" />
	<haxelib name="flixel-animate" />
	<haxelib
		name="nape-haxe4"
		if="NAPE_ENABLED"/>

	<haxelib name="hscript-improved" />
	<haxelib name="mobile-controls" />

	<haxelib
		name="hxdiscord_rpc"
		if="DISCORD_RPC"/>

	<haxelib name="markdown" />

	<haxelib
		name="hxcpp-debug-server"
		if="TEST_BUILD debug" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set
		name="BUILD_DIR"
		value="export/debug"
		if="debug" />

	<set
		name="BUILD_DIR"
		value="export/release"
		unless="debug" />

	<set
		name="BUILD_DIR"
		value="export/debug-32bit"
		if="debug 32bit" />

	<set
		name="BUILD_DIR"
		value="export/release-32bit"
		if="32bit"
		unless="debug" />

	<set
		name="BUILD_DIR"
		value="latest/"
		if="beta" />

	<!-- Source code -->
	<source name="source" />

	<!-- _____________________________ Asset Settings _____________________________ -->

	<!--
		PRELOAD_ALL makes the embedded assets library preload all assets.

		For standalone builds this is the main content source.
	-->
	<define
		name="PRELOAD_ALL"
		unless="web" />

	<define
		name="NO_PRELOAD_ALL"
		unless="PRELOAD_ALL"/>

	<library
		name="assets"
		preload="true"
		if="PRELOAD_ALL"/>

	<library
		name="assets"
		preload="false"
		if="NO_PRELOAD_ALL" />

	<!--
		Embedded assets.

		Everything inside assets/ becomes part of the APK/build.
	-->
	<section unless="TEST_BUILD">

		<assets
			path="assets/"
			rename="assets"
			exclude="*.ogg"
			if="web"/>

		<assets
			path="assets/"
			rename="assets"
			exclude="*.mp3"
			unless="web"/>

	</section>

	<!--
		IMPORTANT:
		There is intentionally NO:

		<assets path="mods" rename="mods" embed="false" />

		The standalone build does not package an external mods folder.
	-->

	<!-- Readme -->
	<assets
		path="art/readme.txt"
		rename="do NOT readme.txt" />

	<!-- ______________________________ OpenAL config ______________________________ -->

	<section if="desktop">

		<assets
			path="building/alsoft.txt"
			rename="plugins/alsoft.ini"
			type="text"
			if="windows"/>

		<assets
			path="building/alsoft.txt"
			rename="plugins/alsoft.conf"
			type="text"
			unless="windows"/>

	</section>

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxeflag
		name="--macro"
		value="funkin.backend.system.macros.BuildInfo.printBuildInfo()" />

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!-- Disable Flixel debugger in release -->
	<haxedef
		name="FLX_NO_DEBUG"
		unless="debug" />

	<!-- Analyzer optimization -->
	<haxedef
		name="analyzer-optimize"
		unless="debug" />

	<!-- Feature defines -->

	<haxedef
		name="VIDEO_CUTSCENES"
		if="VIDEO_CUTSCENES" />

	<haxedef
		name="UPDATE_CHECKING"
		if="UPDATE_CHECKING" />

	<haxedef
		name="DISCORD_RPC"
		if="DISCORD_RPC" />

	<haxedef
		name="SHOW_BUILD_ON_FPS"
		if="SHOW_BUILD_ON_FPS" />

	<haxedef
		name="SOFTCODED_CLASSES"
		if="SOFTCODED_CLASSES" />

	<!--
		DO NOT enable USE_ADAPTED_ASSETS.
		Standalone builds use embedded assets/.
	-->

	<haxedef
		name="openfl_dpi_aware"
		if="openfl_dpi_aware" />

	<!-- Concise compilation errors -->
	<haxedef
		name="message.reporting"
		value="pretty" />

	<!-- _________________________________ Custom _______________________________ -->

	<!-- Custom icons -->

	<icon path="art/icon16.png" size="16"/>
	<icon path="art/icon32.png" size="24"/>
	<icon path="art/icon32.png" size="32"/>
	<icon path="art/icon64.png" size="40"/>
	<icon path="art/icon64.png" size="48"/>
	<icon path="art/icon64.png" size="64"/>

	<icon path="art/iconOG.png" size="96"/>
	<icon path="art/iconOG.png" size="128"/>
	<icon path="art/iconOG.png" size="196"/>
	<icon path="art/iconOG.png" size="256"/>
	<icon path="art/iconOG.png" size="512"/>
	<icon path="art/iconOG.png" size="768"/>
	<icon path="art/iconOG.png" size="1024"/>

	<!-- _________________________________ Additional stuff _______________________________ -->

	<!-- Modcharting -->
	<section if="MODCHARTING_FEATURES">

		<haxedef
			name="FM_ENGINE"
			value="CODENAME"/>

		<haxedef
			name="FM_ENGINE_VERSION"
			value="1.0"/>

		<haxelib name="funkin-modchart" />

		<haxeflag
			name="--macro"
			value="modchart.backend.macros.Macro.includeFiles()"/>

	</section>

	<!-- Compile all classes -->
	<section if="COMPILE_ALL_CLASSES">

		<haxeflag
			name="-dce"
			value="no" />

		<haxeflag
			name="--macro"
			value="funkin.backend.system.macros.Macros.addAdditionalClasses()" />

	</section>

	<!-- Engine macros -->
	<haxeflag
		name="--macro"
		value="funkin.backend.system.macros.Macros.initMacros()" />

	<!-- Mobile teaser icon -->
	<icon
		path="art/teaser.png"
		if="mobile" />

	<!-- Android certificate -->
	<certificate
		path="key.keystore"
		password="psychengine"
		alias="psychport"
		alias-password="psychengine"
		if="android"
		unless="debug" />

	<!-- Lime fixes -->
	<haxedef name="lime_use_old_deltatime" />
	<haxedef name="lime_disable_motion_sensors" />

	<!-- iOS -->
	<section if="ios">

		<haxedef name="SHARE_MOBILE_FILES" />

		<config:ios
			category_type="public.app-category.music-games" />

	</section>

	<!-- Fix compiling issues -->
	<setenv
		name="HAXEPATH"
		value="./"/>

	<!-- 32-bit -->
	<haxedef
		name="HXCPP_M32"
		if="32bit" />

	<!-- Debug -->
	<haxedef
		name="HXCPP_DEBUG_LINK"
		if="debug" />

	<haxedef name="HXCPP_CHECK_POINTER" />
	<haxedef name="HXCPP_STACK_LINE" />
	<haxedef name="HXCPP_CATCH_SEGV" />

	<!-- HScript logging -->
	<haxedef name="hscriptPos" />

	<!-- Experimental features -->
	<haxedef name="EXPERIMENTAL_FLXGRAPHIC_DESTROY_FIX" />

</project>
